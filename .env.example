# =============================================================================
# SiliconPilot AI — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit '.env' to version control.

# Vision Provider API Credentials (Optional)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Model Selection Overrides (Optional)
SILICONPILOT_GEMINI_MODEL="gemini-3.8-flash"
SILICONPILOT_OPENAI_MODEL="gpt-6-astra"

# ngspice Shared Library Path (Windows / KiCad)
# NGSPICE_DLL="C:\\Program Files\\KiCad\\9.0\\bin\\ngspice.dll"
# NGSPICE_DLL="C:\\Users\\<YourUsername>\\AppData\\Local\\Programs\\KiCad\\10.0\\bin\\ngspice.dll"

# Token Cost Estimation (Optional USD per million tokens)
# SILICONPILOT_GEMINI_INPUT_USD_PER_MILLION_TOKENS="0.15"
# SILICONPILOT_GEMINI_OUTPUT_USD_PER_MILLION_TOKENS="0.60"
# SILICONPILOT_OPENAI_INPUT_USD_PER_MILLION_TOKENS="2.50"
# SILICONPILOT_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS="10.00"
